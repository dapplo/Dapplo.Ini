<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dapplo.Ini.WindowsPolicies.Tool</RootNamespace>
    <AssemblyName>dapplo-ini-admx</AssemblyName>
    <PackageId>Dapplo.Ini.WindowsPolicies.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dapplo-ini-admx</ToolCommandName>
    <RollForward>Major</RollForward>
    <!-- Runs on any OS: generating templates and .reg files needs no registry. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Description>dotnet tool that generates an ADMX/ADML administrative template (and optionally a .reg file) from the Dapplo.Ini sections of an application assembly.</Description>
    <PackageTags>ini;configuration;group-policy;gpo;intune;admx</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dapplo.Ini.WindowsPolicies\Dapplo.Ini.WindowsPolicies.csproj" />
  </ItemGroup>

</Project>
